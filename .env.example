# Pick one: gemini | openrouter | groq | cerebras | mistral | bytez
AI_PROVIDER=gemini

# --- Gemini (recommended default — see README) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.1-flash
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
APP_URL=https://your-app.vercel.app

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cerebras ---
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# --- Mistral ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# --- Bytez (best-effort integration, see lib/providers.ts) ---
BYTEZ_API_KEY=
BYTEZ_MODEL=

# Optional override if a model's real context window differs from the built-in guess
CONTEXT_WINDOW_TOKENS=

# --- Usage limiting (recommended before making this public) ---
# Created automatically when you connect an Upstash Redis database in Vercel's
# Storage tab. Without these, the app still works but has NO usage cap.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_CHAT_PER_HOUR=30
RATE_LIMIT_IMAGE_PER_HOUR=8
